page {
  --ink: #1c1917;
  --ink-soft: #44403c;
  --muted: #78716c;
  --paper: #f5f2eb;
  --paper-raised: #fafaf9;
  --line: #e7e5e4;
  --accent: #0f766e;
  --danger: #b91c1c;
  --warn: #b45309;
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.container {
  padding: 28rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand {
  font-family: "Songti SC", "Source Han Serif SC", "Noto Serif SC", serif;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.h1 {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.h2 {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1.35;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.section-gap {
  margin-top: 36rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--ink);
  color: #fafaf9;
}

.btn-primary[disabled] {
  background: #a8a29e;
  color: #fafaf9;
}

.btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 2rpx solid var(--line);
}

.btn-accent {
  background: var(--accent);
  color: #fafaf9;
}

.field {
  background: var(--paper-raised);
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.field-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 44rpx;
}

.notice {
  background: rgba(15, 118, 110, 0.08);
  border-left: 6rpx solid var(--accent);
  padding: 20rpx 24rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.notice.warn {
  background: rgba(180, 83, 9, 0.08);
  border-left-color: var(--warn);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--muted);
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--ink-soft);
  background: #e7e5e4;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  border-radius: 4rpx;
}
